# WooCommerce shop (WordPress) used for public product prices (Store API) and the cart hand-off.
# Public: it is inlined into the browser bundle. Leave empty to run without a shop.
NEXT_PUBLIC_WOOCOMMERCE_URL=

# --- Server only (never prefix with NEXT_PUBLIC_) -------------------------------------------------
# WordPress base URL as reachable from the Next.js server (may be an internal address).
MULTI3D_WP_URL=
# Shared secret for signing server-to-server requests, at least 32 random characters.
# Define the same value in wp-config.php: define( 'MULTI3D_BFF_SECRET', '...' );
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MULTI3D_BFF_SECRET=
# Public origin of the configurator: base of shared links and the only accepted Origin (CSRF).
MULTI3D_PUBLIC_URL=
# Number of reverse proxies in front of Next.js that append to X-Forwarded-For (rate limiting).
MULTI3D_TRUSTED_PROXY_HOPS=0
# Development only, plain http on a host other than localhost: 1 disables the Secure cookie flag.
# MULTI3D_INSECURE_COOKIES=1
